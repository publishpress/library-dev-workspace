#. Plugin Name of the plugin
#: fake-plugin.php:3
msgid "Fake Plugin"
msgstr "Fake Plugin"

#. Plugin URI of the plugin
#: fake-plugin.php:4
msgid "https://publishpress.com"
msgstr "https://publishpress.com"

#. Description of the plugin
#: fake-plugin.php:5
msgid ""
"A minimal fake WordPress plugin used to test publishpress/dev-workspace "
"locally."
msgstr ""
"Un plugin de WordPress minimalista y ficticio que se utiliza para probar "
"publishpress/dev-workspace en un entorno local."

#. Author of the plugin
#: fake-plugin.php:7
msgid "PublishPress"
msgstr "PublishPress"

#: fake-plugin.php:25
msgid "This is the first sample string for plain gettext."
msgstr "Esta es la primera cadena de ejemplo para gettext sin formato."

#: fake-plugin.php:26
msgid "This is the second sample string for plain gettext."
msgstr "Esta es la segunda cadena de ejemplo para gettext sin formato."

#: fake-plugin.php:27
msgid "This is the third sample string for plain gettext."
msgstr "Esta es la tercera cadena de ejemplo para gettext sin formato."

#: fake-plugin.php:31
msgid "This sentence is printed with gettext using immediate echo."
msgstr "Esta frase se ha generado con gettext mediante la salida inmediata."

#: fake-plugin.php:35
msgid "This line uses esc_html_e so unsafe markup cannot break the layout."
msgstr ""
"Esta línea utiliza esc_html_e para evitar que el código HTML no seguro "
"altere el diseño."

#: fake-plugin.php:39
msgid "This value uses esc_attr_e and belongs inside an HTML attribute."
msgstr ""
"Este valor utiliza esc_attr_e y debe aparecer dentro de un atributo HTML."

#: fake-plugin.php:43
msgid "This line uses esc_html__ and returns a value instead of echoing it."
msgstr ""
"Esta línea utiliza esc_html__ y devuelve un valor en lugar de mostrarlo en "
"pantalla."

#: fake-plugin.php:44
msgid "This line uses esc_attr__ for text stored in an attribute."
msgstr "Esta línea utiliza esc_attr__ para el texto almacenado en un atributo."

#: fake-plugin.php:47
msgctxt "Button label: start recording audio or video."
msgid "Record"
msgstr "Grabar"

#: fake-plugin.php:52
msgctxt "Noun: a single audio or video recording you can play back."
msgid "Record"
msgstr "Grabación"

#: fake-plugin.php:59
msgctxt "Button label: close the dialog without keeping changes."
msgid "Leave"
msgstr "Salir"

#. translators: %d: number of items
#: fake-plugin.php:69
#, php-format
msgid "There is %d item in this plural-form test."
msgid_plural "There are %d items in this plural-form test."
msgstr[0] "Hay %d elemento en esta prueba de forma plural."
msgstr[1] "Hay %d elementos en esta prueba de forma plural."

#. translators: %s: number of messages
#: fake-plugin.php:80
#, php-format
msgctxt "Count of admin notices about translation tests."
msgid "You have %d message that needs gettext context."
msgid_plural "You have %d messages that need gettext context."
msgstr[0] "Tienes %d mensaje que necesita contexto de gettext."
msgstr[1] "Tienes %d mensajes que necesitan contexto de gettext."

#. translators: %s: a short word inserted into the sentence
#: fake-plugin.php:92
#, php-format
msgid "This sentence has one slot for a word: today we say %s."
msgstr "En esta frase hay un espacio para una palabra: hoy decimos %s."

#. translators: %1$s: earlier phrase, %2$s: later phrase (translators may reorder)
#: fake-plugin.php:98
#, php-format
msgid "We name two things in source order: first %1$s, then %2$s."
msgstr ""
"Nombramos dos elementos en el orden en que aparecen en la fuente: primero "
"%1$s y luego %2$s."

#. translators: %1$s and %2$s appear out of numerical order on purpose
#: fake-plugin.php:105
#, php-format
msgid "The later clause mentions %2$s before the earlier clause mentions %1$s."
msgstr ""
"La cláusula posterior menciona %2$s antes de que la cláusula anterior "
"mencione %1$s."

#. translators: %1$s is the product name, %2$s is the star rating markup or label
#: fake-plugin.php:113
#, php-format
msgid "If you like %1$s, please leave us a %2$s rating. Thank you!"
msgstr "Si te gusta %1$s, déjanos una valoración de %2$s. ¡Gracias!"

#. translators: %s: module title — control next to %1$s/%2$s strings (issue #81 compares these)
#: fake-plugin.php:120
#, php-format
msgid "About %s"
msgstr "Acerca de %s"

#. translators: %1$s: name, %2$s: place, %3$s: time word (order may change per language)
#: fake-plugin.php:126
#, php-format
msgid "Meet %1$s from %2$s at %3$s."
msgstr "Encuentra a %1$s de %2$s a las %3$s."

#. translators: %1$d: count, %2$s: unit label
#: fake-plugin.php:134
#, php-format
msgid "We counted %1$d items and labeled the batch as %2$s."
msgstr "Hemos contado %1$d elementos y hemos etiquetado el lote como %2$s."

#. translators: Numbered placeholders split across a line break in the source (multiline msgid).
#: fake-plugin.php:141
#, php-format
msgid ""
"The first line names %1$s,\n"
"and the second line names %2$s."
msgstr ""
"La primera línea se llama %1$s,\n"
"y la segunda línea se llama %2$s."

#. translators: %d: a whole number in a test phrase
#: fake-plugin.php:152
#, php-format
msgid "The integer placeholder in this test reads exactly %d."
msgstr ""
"El marcador de posición para números enteros en esta prueba muestra "
"exactamente %d."

#: fake-plugin.php:158
msgid ""
"Quotes inside one string can mix apostrophes and double quotes, like it's "
"short and \"quoted\"."
msgstr ""
"Las comillas dentro de una cadena pueden mezclar apóstrofos y comillas "
"dobles, como si fuera «cita» abreviada."

#: fake-plugin.php:164
msgid ""
"This message is split across two lines in the source file.\n"
"Please translate it as one natural sentence, not two separate labels."
msgstr ""
"Este mensaje aparece dividido en dos líneas en el archivo fuente.\n"
"Por favor, tradúcelo como una sola frase natural, no como dos etiquetas "
"separadas."

