#: fake-plugin.php:3
#. Plugin Name of the plugin
msgid "Fake Plugin"
msgstr "Hamis Plugin"

#: fake-plugin.php:4
#. Plugin URI of the plugin
#, fuzzy
msgid "https://publishpress.com"
msgstr "https://publishpress.com"

#: fake-plugin.php:5
#. Description of the plugin
msgid ""
"A minimal fake WordPress plugin used to test publishpress/dev-workspace "
"locally."
msgstr ""
"Egy minimális hamis WordPress plugin, amelyet a publishpress/dev-workspace "
"helyi tesztelésére használnak."

#: fake-plugin.php:7
#. Author of the plugin
#, fuzzy
msgid "PublishPress"
msgstr "PublishPress"

#: fake-plugin.php:25
msgid "This is the first sample string for plain gettext."
msgstr "Ez az első minta szöveg a sima gettext számára."

#: fake-plugin.php:26
msgid "This is the second sample string for plain gettext."
msgstr "Ez a második minta szöveg a sima gettext számára."

#: fake-plugin.php:27
msgid "This is the third sample string for plain gettext."
msgstr "Ez a harmadik minta szöveg a sima gettext számára."

#: fake-plugin.php:31
msgid "This sentence is printed with gettext using immediate echo."
msgstr ""
"Ez a mondat közvetlen echo használatával van nyomtatva a gettext "
"segítségével."

#: fake-plugin.php:35
msgid "This line uses esc_html_e so unsafe markup cannot break the layout."
msgstr ""
"Ez a sor az esc_html_e-t használja, így a nem biztonságos jelölés nem "
"törheti meg a megjelenítést."

#: fake-plugin.php:39
msgid "This value uses esc_attr_e and belongs inside an HTML attribute."
msgstr "Ez az érték az esc_attr_e-t használja, és HTML attribútumon belül található."

#: fake-plugin.php:43
msgid "This line uses esc_html__ and returns a value instead of echoing it."
msgstr ""
"Ez a sor az esc_html__-t használja, és egy értéket ad vissza ahelyett, hogy "
"kiírná."

#: fake-plugin.php:44
msgid "This line uses esc_attr__ for text stored in an attribute."
msgstr ""
"Ez a sor az esc_attr__-t használja, amely egy attribútumban tárolt szövegre "
"vonatkozik."

#: fake-plugin.php:69
#. translators: %d: number of items
#, php-format
msgid "There is %d item in this plural-form test."
msgid_plural "There are %d items in this plural-form test."
msgstr[0] "Ebben a többes számú tesztben %d elem található."
msgstr[1] "Ebben a többes számú tesztben %d elem található."

#: fake-plugin.php:92
#. translators: %s: a short word inserted into the sentence
#, php-format
msgid "This sentence has one slot for a word: today we say %s."
msgstr "Ez a mondat tartalmaz egy helyet egy szóra: ma azt mondjuk, hogy %s."

#: fake-plugin.php:98
#. translators: %1$s: earlier phrase, %2$s: later phrase (translators may reorder)
#, php-format
msgid "We name two things in source order: first %1$s, then %2$s."
msgstr "Két dolgot nevezünk meg a forrás sorrendjében: először %1$s, aztán %2$s."

#: fake-plugin.php:105
#. translators: %1$s and %2$s appear out of numerical order on purpose
#, php-format
msgid "The later clause mentions %2$s before the earlier clause mentions %1$s."
msgstr ""
"A későbbi kifejezés %2$s-t említi meg, mielőtt a korábbi kifejezés %1$s-t "
"említené."

#: fake-plugin.php:113
#. translators: %1$s is the product name, %2$s is the star rating markup or label
#, php-format
msgid "If you like %1$s, please leave us a %2$s rating. Thank you!"
msgstr "Ha tetszik a %1$s, kérjük, adj nekünk egy %2$s értékelést. Köszönjük!"

#: fake-plugin.php:120
#. translators: %s: module title — control next to %1$s/%2$s strings (issue #81 compares these)
#, php-format
msgid "About %s"
msgstr "A %s-ről"

#: fake-plugin.php:126
#. translators: %1$s: name, %2$s: place, %3$s: time word (order may change per language)
#, php-format
msgid "Meet %1$s from %2$s at %3$s."
msgstr "Találkozz %1$s-sel a %2$s-ból %3$s-kor."

#: fake-plugin.php:134
#. translators: %1$d: count, %2$s: unit label
#, php-format
msgid "We counted %1$d items and labeled the batch as %2$s."
msgstr "Összesen %1$d elemet számoltunk meg, és a tételt %2$s névvel láttuk el."

#: fake-plugin.php:141
#. translators: Numbered placeholders split across a line break in the source (multiline msgid).
#, php-format
msgid ""
"The first line names %1$s,\n"
"and the second line names %2$s."
msgstr ""
"Az első sor nevezi %1$s-t,  \n"
"a második sor nevezi %2$s-t."

#: fake-plugin.php:152
#. translators: %d: a whole number in a test phrase
#, php-format
msgid "The integer placeholder in this test reads exactly %d."
msgstr "A tesztben szereplő egész szám helyettesítő pontosan %d."

#: fake-plugin.php:158
msgid ""
"Quotes inside one string can mix apostrophes and double quotes, like it's "
"short and \"quoted\"."
msgstr ""
"Az idézetek egyetlen karakterláncon belül keverhetik az aposztrófokat és a "
"dupla idézőjeleket, mint például, hogy ez rövid és \"idézett\"."

#: fake-plugin.php:164
msgid ""
"This message is split across two lines in the source file.\n"
"Please translate it as one natural sentence, not two separate labels."
msgstr ""
"Ez az üzenet két sorra van bontva a forrásfájlban.  \n"
"Kérjük, fordítsa le természetes mondatként, ne két külön címkének."

#: fake-plugin.php:47
msgctxt "Button label: start recording audio or video."
msgid "Record"
msgstr "Felvétel"

#: fake-plugin.php:52
msgctxt "Noun: a single audio or video recording you can play back."
msgid "Record"
msgstr "Felvétel"

#: fake-plugin.php:59
msgctxt "Button label: close the dialog without keeping changes."
msgid "Leave"
msgstr "Kilépés"

#: fake-plugin.php:80
#. translators: %s: number of messages
#, php-format
msgctxt "Count of admin notices about translation tests."
msgid "You have %d message that needs gettext context."
msgid_plural "You have %d messages that need gettext context."
msgstr[0] "Önnek %d üzenete van, amely gettext kontextust igényel."
msgstr[1] "Önnek %d üzenete van, amelyek gettext kontextust igényelnek."
