#. Plugin Name of the plugin
#: fake-plugin.php:3
msgid "Fake Plugin"
msgstr "Fausse extension"

#. Plugin URI of the plugin
#: fake-plugin.php:4
msgid "https://publishpress.com"
msgstr "https://publishpress.com"

#. Description of the plugin
#: fake-plugin.php:5
msgid ""
"A minimal fake WordPress plugin used to test publishpress/dev-workspace "
"locally."
msgstr ""
"Une fausse extension WordPress minimaliste servant à tester publishpress/dev-"
"workspace en local."

#. Author of the plugin
#: fake-plugin.php:7
msgid "PublishPress"
msgstr "PublishPress"

#: fake-plugin.php:25
msgid "This is the first sample string for plain gettext."
msgstr "Voici la première chaîne d’exemple pour gettext standard."

#: fake-plugin.php:26
msgid "This is the second sample string for plain gettext."
msgstr "Voici la deuxième chaîne d’exemple pour gettext standard."

#: fake-plugin.php:27
msgid "This is the third sample string for plain gettext."
msgstr "Voici la troisième chaîne d’exemple pour gettext standard."

#: fake-plugin.php:31
msgid "This sentence is printed with gettext using immediate echo."
msgstr ""
"Cette phrase est affichée à l’aide de gettext en utilisant immediate echo."

#: fake-plugin.php:35
msgid "This line uses esc_html_e so unsafe markup cannot break the layout."
msgstr ""
"Cette ligne utilise esc_html_e afin d’éviter que du code HTML non sécurisé "
"ne vienne casser la mise en page."

#: fake-plugin.php:39
msgid "This value uses esc_attr_e and belongs inside an HTML attribute."
msgstr "Cette valeur utilise esc_attr_e et est placée dans un attribut HTML."

#: fake-plugin.php:43
msgid "This line uses esc_html__ and returns a value instead of echoing it."
msgstr ""
"Cette ligne utilise esc_html__ et renvoie une valeur au lieu de l’afficher."

#: fake-plugin.php:44
msgid "This line uses esc_attr__ for text stored in an attribute."
msgstr "Cette ligne utilise esc_attr__ pour le texte stocké dans un attribut."

#: fake-plugin.php:47
msgctxt "Button label: start recording audio or video."
msgid "Record"
msgstr "Enregistrer"

#: fake-plugin.php:52
msgctxt "Noun: a single audio or video recording you can play back."
msgid "Record"
msgstr "Enregistrement"

#: fake-plugin.php:59
msgctxt "Button label: close the dialog without keeping changes."
msgid "Leave"
msgstr "Quitter"

#. translators: %d: number of items
#: fake-plugin.php:69
#, php-format
msgid "There is %d item in this plural-form test."
msgid_plural "There are %d items in this plural-form test."
msgstr[0] "Il y a %d élément dans ce test sur la forme plurielle."
msgstr[1] "Il y a %d éléments dans ce test sur la forme plurielle."

#. translators: %s: number of messages
#: fake-plugin.php:80
#, php-format
msgctxt "Count of admin notices about translation tests."
msgid "You have %d message that needs gettext context."
msgid_plural "You have %d messages that need gettext context."
msgstr[0] "Vous avez %d message qui nécessite un contexte gettext."
msgstr[1] "Vous avez %d messages qui nécessitent un contexte gettext."

#. translators: %s: a short word inserted into the sentence
#: fake-plugin.php:92
#, php-format
msgid "This sentence has one slot for a word: today we say %s."
msgstr ""
"Cette phrase comporte un emplacement pour un mot : aujourd’hui, on dit %s."

#. translators: %1$s: earlier phrase, %2$s: later phrase (translators may reorder)
#: fake-plugin.php:98
#, php-format
msgid "We name two things in source order: first %1$s, then %2$s."
msgstr ""
"Nous nommons deux éléments dans l’ordre d’apparition : d’abord %1$s, puis "
"%2$s."

#. translators: %1$s and %2$s appear out of numerical order on purpose
#: fake-plugin.php:105
#, php-format
msgid "The later clause mentions %2$s before the earlier clause mentions %1$s."
msgstr ""
"La clause suivante mentionne %2$s avant que la clause précédente ne "
"mentionne %1$s."

#. translators: %1$s is the product name, %2$s is the star rating markup or label
#: fake-plugin.php:113
#, php-format
msgid "If you like %1$s, please leave us a %2$s rating. Thank you!"
msgstr ""
"Si vous appréciez %1$s, veuillez nous laisser une note de %2$s. Merci !"

#. translators: %s: module title — control next to %1$s/%2$s strings (issue #81 compares these)
#: fake-plugin.php:120
#, php-format
msgid "About %s"
msgstr "À propos de %s"

#. translators: %1$s: name, %2$s: place, %3$s: time word (order may change per language)
#: fake-plugin.php:126
#, php-format
msgid "Meet %1$s from %2$s at %3$s."
msgstr "Rendez-vous avec %1$s de %2$s à %3$s."

#. translators: %1$d: count, %2$s: unit label
#: fake-plugin.php:134
#, php-format
msgid "We counted %1$d items and labeled the batch as %2$s."
msgstr "Nous avons compté %1$d éléments et avons nommé le lot %2$s."

#. translators: Numbered placeholders split across a line break in the source (multiline msgid).
#: fake-plugin.php:141
#, php-format
msgid ""
"The first line names %1$s,\n"
"and the second line names %2$s."
msgstr ""
"La première ligne nomme %1$s,\n"
"et la deuxième ligne nomme %2$s."

#. translators: %d: a whole number in a test phrase
#: fake-plugin.php:152
#, php-format
msgid "The integer placeholder in this test reads exactly %d."
msgstr ""
"Dans ce test, le espace réservé pour les nombres entiers affiche exactement "
"%d."

#: fake-plugin.php:158
msgid ""
"Quotes inside one string can mix apostrophes and double quotes, like it's "
"short and \"quoted\"."
msgstr ""
"Les guillemets à l’intérieur d’une chaîne peuvent mélanger apostrophes et "
"guillemets doubles, comme dans n’est pas long et « entre guillemets »."

#: fake-plugin.php:164
msgid ""
"This message is split across two lines in the source file.\n"
"Please translate it as one natural sentence, not two separate labels."
msgstr ""
"Ce message est réparti sur deux lignes dans le fichier source.\n"
"Veuillez le traduire en une seule phrase naturelle, et non en deux "
"étiquettes distinctes."

